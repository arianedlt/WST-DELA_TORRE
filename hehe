<!DOCTYPE html>
<html>
<head>
    <title>Half Heart Necklace</title>

    <style>
        body {
            background: #ffe6f0;
            font-family: Arial, sans-serif;
            text-align: center;
            padding-top: 40px;
        }

        h1 {
            color: #d63384;
        }

        .necklace {
            position: relative;
            width: 300px;
            height: 250px;
            margin: 30px auto;
        }

        /* Necklace chain */
        .chain {
            position: absolute;
            width: 130px;
            height: 130px;
            border: 3px solid silver;
            border-bottom: none;
            border-radius: 100px 100px 0 0;
            top: 10px;
            left: 82px;
        }

        /* Heart pieces */
        .piece {
            position: absolute;
            width: 70px;
            height: 70px;
            top: 100px;
            transition: left 1s ease;
        }

        .piece svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        #leftHeart {
            left: 65px;
        }

        #rightHeart {
            left: 165px;
        }

        button {
            background: #d63384;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 16px;
        }

        #message {
            color: #d63384;
            font-size: 18px;
        }
    </style>
</head>

<body>

    <h1>Half-Heart Necklace</h1>
    <p>Click the button to complete the heart.</p>

    <div class="necklace">

        <div class="chain"></div>

        <!-- Left half of the heart -->
        <div class="piece" id="leftHeart">
            <svg viewBox="0 0 100 100">
                <path d="M50 90 L12 52
                         C-8 30 10 5 30 12
                         C42 15 48 25 50 32 Z"
                      fill="#ff4f87"
                      stroke="#c2185b"
                      stroke-width="2"/>
            </svg>
        </div>

        <!-- Right half of the heart -->
        <div class="piece" id="rightHeart">
            <svg viewBox="0 0 100 100">
                <path d="M50 90 L88 52
                         C108 30 90 5 70 12
                         C58 15 52 25 50 32 Z"
                      fill="#ff4f87"
                      stroke="#c2185b"
                      stroke-width="2"/>
            </svg>
        </div>

    </div>

    <button id="connectButton">Connect the Heart</button>

    <p id="message"></p>

    <script>
        const leftHeart = document.getElementById("leftHeart");
        const rightHeart = document.getElementById("rightHeart");
        const connectButton = document.getElementById("connectButton");
        const message = document.getElementById("message");

        let connected = false;

        connectButton.addEventListener("click", function() {

            if (connected === false) {
                leftHeart.style.left = "95px";
                rightHeart.style.left = "95px";

                message.textContent = "The heart is complete!";
                connectButton.textContent = "Separate the Heart";

                connected = true;

            } else {
                leftHeart.style.left = "65px";
                rightHeart.style.left = "165px";

                message.textContent = "";
                connectButton.textContent = "Connect the Heart";

                connected = false;
            }

        });
    </script>

</body>
</html>